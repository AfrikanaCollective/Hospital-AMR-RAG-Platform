# Hospital RAG Platform — configuration template.
# Copy to .env and edit. .env is gitignored. Never put secrets in .env.example.
# Full reference: ARCHITECTURE.md §20.

# ─── App ───────────────────────────────────────────────────────────────────────
APP_ENV=dev                       # dev | staging | prod
LOG_LEVEL=INFO
API_BASE_PATH=/api
REQUEST_ID_HEADER=x-request-id

# ─── LLM gateway (ARCH-005 / PRD-101 / PRD-102) ───────────────────────────────
# http:// is only accepted here for the docker-compose-internal dev stub. The
# real gateway is external (ARCHITECTURE.md §19) and this call path carries
# PHI-adjacent content for SCOPE-2 flows — use https:// for anything else, or
# app.config.Settings.validate_gateway_transport logs a warning at startup
# (PRD-082, ARCH §17.2, DEVIATIONS.md #54).
LLM_GATEWAY_URL=http://llm-gateway:8080
LLM_GATEWAY_API_KEY=               # Bearer token; set only in your local .env, never committed
MODEL_ID=<set-me>                  # REQUIRED. Answer path refuses to start on this placeholder.
MODEL_ID_FALLBACKS=               # comma-separated fallback model ids (fallback routing)
MODEL_ID_VERIFIED=false           # set true ONLY after checking the id against current gateway docs
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ─── Embeddings / reranker (ARCH-004 / ARCH-012 / PRD-103) ────────────────────
# Placeholder defaults below are UNVERIFIED — confirm or override before relying on them.
EMBEDDING_BACKEND=stub            # local | gateway | stub
# EMBEDDING_MODEL_ID format depends on EMBEDDING_BACKEND:
#   local   -> a HuggingFace repo id, e.g. BAAI/bge-large-en-v1.5
#   gateway -> the gateway's own model tag, e.g. qllama/bge-large-en-v1.5:latest
#              (operator-confirmed against a real self-hosted gateway; DEVIATIONS.md #42)
EMBEDDING_MODEL_ID=BAAI/bge-large-en-v1.5
EMBEDDING_MODEL_VERIFIED=false
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOC_PREFIX=
# Only used once EMBEDDING_BACKEND=gateway is implemented (Phase 2). May be a
# different host/service than LLM_GATEWAY_URL above. Never put the real API
# key in this file — set it in your local .env only.
EMBEDDING_GATEWAY_URL=
EMBEDDING_GATEWAY_API_KEY=
RERANKER_BACKEND=local             # decided (DEVIATIONS.md #44) — gateway is not a supported option here
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_VERIFIED=false
# Local in-process serving knobs (DEVIATIONS.md #43/#44).
# Design: sentence-transformers CrossEncoder — install the `local-models`
# extra (pip install -e ".[dev,local-models]") to get it + torch. NOTE: the
# committed backend/Dockerfile does NOT install this extra by default (kept
# light for the stub-only image); building api/worker images that actually
# run RERANKER_BACKEND=local needs `.[dev,local-models]` added there first —
# not yet done (Phase 2 work). Tests always force RERANKER_BACKEND=stub via
# tests/conftest.py regardless of this file, so `make test`/CI is unaffected.
RERANKER_DEVICE=auto              # auto | cpu | cuda
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
# Where HF model weights are cached inside the container — point this at a
# persistent volume (see docker-compose.yml `hf-model-cache`) so the ~1.1GB
# reranker weights aren't re-downloaded from the internet on every restart.
HF_HOME=/home/appuser/.cache/huggingface

# ─── Retrieval (ARCH-003 / §7) ───────────────────────────────────────────────
CANDIDATE_K=40
FUSED_K=24
TOP_K=8
RRF_K=60
RETRIEVAL_MIN_SCORE=0.30          # tune on the eval set
SUPPORT_SCORE_FLOOR=0.20
MIN_SUPPORTING_CHUNKS=2
GROUNDING_ENTAILMENT_MODE=hybrid  # lexical | model | hybrid

# ─── Vector store (ARCH-002) ─────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me-in-real-deploy
QDRANT_GUIDELINE_COLLECTION=guideline_chunks_v1
PATIENT_RECORD_VECTORS_ENABLED=false          # keep off (ARCH-023 / DEVIATIONS #8)

# ─── Guideline corpus + ingestion (ARCH-038 / DEVIATIONS #26, #28, #30) ──────
SAMPLE_GUIDELINES_DIR=data/sample_guidelines
GUIDELINES_ALLOW_SYNTHETIC=false               # true = allow the CI-only synthetic fixture set
INGEST_MIN_PARSE_QUALITY=0.60                   # below -> document held for admin review

# ─── Patient records (ARCH-039 / DEVIATIONS #30, #33, #34) ───────────────────
PATIENT_RECORDS_DIR=data/patient_records        # synthetic/ + deidentified/<dataset>/ live here
RECORD_DOMAIN=neonatal                          # neonatal | adult_inpatient — synthetic generator + corpus domain
DEIDENTIFIED_ATTESTATION_REQUIRED=true          # de-identified datasets need a complete DATASET.md attestation

# ─── Database (ARCH-008) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://hrag_app:hrag_app_pw@postgres:5432/hospital_rag
# app role has NO UPDATE/DELETE on the audit schema — see deploy/postgres/init/01_schemas_roles.sql
# Alembic-only, elevated (DDL) credential — hrag_app above has no CREATE
# privilege on the managed schemas, by design (DEVIATIONS.md #61). Never used
# by the running app, only by `alembic upgrade`/`alembic revision`.
ALEMBIC_DATABASE_URL=postgresql+psycopg://hrag_admin:hrag_admin_pw@postgres:5432/hospital_rag

# ─── Async (ARCH-007) ───────────────────────────────────────────────────────
REDIS_URL=redis://:redis_pw@redis:6379/0
CELERY_BROKER_URL=redis://:redis_pw@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis_pw@redis:6379/2

# ─── Auth / RBAC (ARCH-011 / ARCH-034) ──────────────────────────────────────
AUTH_PROVIDER=devjwt              # devjwt | oidc
DEVJWT_SIGNING_KEY=dev-only-change-me
DEVJWT_ISSUER=hospital-rag-dev
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=

# ─── Crypto / secrets (ARCH-032 / ARCH-033) ─────────────────────────────────
SECRETS_BACKEND=file             # env | file | vault
CRYPTO_KEK_FILE=./secrets/dev_kek.bin   # DEV KEY — not for real data
VAULT_ADDR=
VAULT_TOKEN=

# ─── HITL / rubric (ARCH-018 / ARCH-020 / ARCH-021) ─────────────────────────
ESCALATION_SLA_MINUTES=60
IRR_MIN_RATERS=3
IRR_METRIC=krippendorff_alpha_ordinal
REVIEW_WEBHOOK_URL=

# ─── Auto question generation (ARCH-022 / PRD-065) ──────────────────────────
QGEN_COMPOSITION=60,20,20         # well_supported,missing_info_expected,no_guideline_expected
QGEN_DEDUP_THRESHOLD=0.92
QGEN_MAX_RETRIES=3

# ─── Eval harness gating (§16) ─────────────────────────────────────────────
EVAL_MIN_PRECISION_AT_8=0.70
EVAL_MIN_RECALL_AT_24=0.80
EVAL_MIN_CITATION_SUPPORT_RATE=0.95
EVAL_REQUIRE_ZERO_SCOPE_VIOLATIONS=true
EVAL_REQUIRE_FULL_DISCLAIMER=true

# ─── Retention (PRD-Q3) ────────────────────────────────────────────────────
RETENTION_AUDIT_DAYS=3650
RETENTION_CONTEXT_DAYS=1825
RETENTION_CONV_DAYS=730
CHECKPOINT_TTL_DAYS=30

# ─── Extension seam (ARCH-026 / CDS-FUTURE.md) ─────────────────────────────
LOCAL_ADAPTATION_ENABLED=false    # inert — flipping this does nothing without governance-gated implementation
