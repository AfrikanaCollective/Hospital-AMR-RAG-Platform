{
  "$comment": "Fixed patient-record schema (PRD-002, PRD-003, PRD-A3). Kept in sync with backend/app/schemas/record.py (PatientRecord). Regenerate with: python -c \"import json,app.schemas.record as r; print(json.dumps(r.PatientRecord.model_json_schema(), indent=2))\". Every field is PHI by default (PRD-080). 1.1.0 neonatal fields (DEVIATIONS #32). 1.2.0 capillary_refill_seconds, examination_findings[], interventions[]; given_name/family_name no longer required (DEVIATIONS #35, #38). 1.3.0 Medication.stopped_at + Intervention.stopped_at — interval end (DEVIATIONS #39). 1.4.0 maternal_risk_factors[] — maternal-history signs, same shape as examination_findings but distinct from the newborn's own signs (DEVIATIONS #139). Temporal entities carry started_at/stopped_at; point-in-time entities carry one *_at. All additions optional.",
  "schema_version": "1.4.0",
  "type": "object",
  "required": ["record_id", "mrn"],
  "properties": {
    "schema_version": {"type": "string"},
    "dataset_provenance": {"type": ["string", "null"], "description": "synthetic-generator-v1 | deidentified-anonymised; unmarked 'real-looking' batches are rejected on ingest"},
    "record_id": {"type": "string"},
    "mrn": {"type": "string", "description": "medical record number (synthesised as DEID-<key> for de-identified data)"},
    "given_name": {"type": ["string", "null"], "description": "absent for de-identified data (1.2.0)"},
    "family_name": {"type": ["string", "null"], "description": "absent for de-identified data (1.2.0)"},
    "date_of_birth": {"type": ["string", "null"], "format": "date"},
    "sex": {"type": ["string", "null"]},
    "encounter": {
      "type": "object",
      "properties": {
        "admitted_at": {"type": ["string", "null"], "format": "date-time"},
        "ward": {"type": ["string", "null"]},
        "care_setting": {"type": ["string", "null"], "description": "adult: ED/ward/HDU/ICU; neonatal: NBU/KMC/nursery/postnatal"},
        "presenting_complaint": {"type": ["string", "null"]},
        "triage_category": {"type": ["string", "null"]},
        "gestational_age_weeks": {"type": ["number", "null"], "description": "neonatal (1.1.0)"},
        "birth_weight_g": {"type": ["number", "null"], "description": "neonatal (1.1.0)"},
        "day_of_life": {"type": ["integer", "null"], "description": "neonatal (1.1.0)"}
      }
    },
    "problems": {"type": "array", "items": {"type": "string"}},
    "allergies": {"type": "array", "items": {"type": "string"}},
    "medications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "dose": {"type": ["string", "null"]},
          "route": {"type": ["string", "null"]},
          "frequency": {"type": ["string", "null"]},
          "started_at": {"type": ["string", "null"], "format": "date-time"},
          "stopped_at": {"type": ["string", "null"], "format": "date-time", "description": "interval end; null = ongoing/unknown (1.3.0)"},
          "active": {"type": "boolean"}
        }
      }
    },
    "vitals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recorded_at": {"type": ["string", "null"], "format": "date-time"},
          "heart_rate_bpm": {"type": ["number", "null"]},
          "resp_rate_bpm": {"type": ["number", "null"]},
          "systolic_bp_mmhg": {"type": ["number", "null"]},
          "diastolic_bp_mmhg": {"type": ["number", "null"]},
          "mean_bp_mmhg": {"type": ["number", "null"], "description": "neonatal (1.1.0)"},
          "temperature_c": {"type": ["number", "null"]},
          "spo2_percent": {"type": ["number", "null"]},
          "weight_g": {"type": ["number", "null"], "description": "monitored vital in neonatal care (1.1.0)"},
          "capillary_refill_seconds": {"type": ["number", "null"], "description": "perfusion (1.2.0)"}
        }
      }
    },
    "examination_findings": {
      "type": "array",
      "description": "history/examination signs, structured so present/absent is preserved (1.2.0)",
      "items": {
        "type": "object",
        "required": ["name", "present"],
        "properties": {
          "name": {"type": "string"},
          "present": {"type": "boolean"},
          "recorded_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "interventions": {
      "type": "array",
      "description": "supportive/therapeutic interventions, distinct from medications (1.2.0)",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "active": {"type": "boolean"},
          "started_at": {"type": ["string", "null"], "format": "date-time"},
          "stopped_at": {"type": ["string", "null"], "format": "date-time", "description": "interval end; null = ongoing/unknown (1.3.0)"}
        }
      }
    },
    "labs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["analyte"],
        "properties": {
          "analyte": {"type": "string"},
          "value": {"type": ["number", "null"]},
          "unit": {"type": ["string", "null"]},
          "collected_at": {"type": ["string", "null"], "format": "date-time"},
          "reference_low": {"type": ["number", "null"]},
          "reference_high": {"type": ["number", "null"]}
        }
      }
    },
    "maternal_risk_factors": {
      "type": "array",
      "description": "maternal-history signs (e.g. maternal infection, PROM), same present/absent shape as examination_findings but distinct from the newborn's own signs (1.4.0)",
      "items": {
        "type": "object",
        "required": ["name", "present"],
        "properties": {
          "name": {"type": "string"},
          "present": {"type": "boolean"},
          "recorded_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "clinical_notes": {"type": ["string", "null"], "description": "free text; encrypted at rest; PHI"},
    "consent_flags": {"type": "object", "additionalProperties": {"type": "boolean"}}
  }
}
